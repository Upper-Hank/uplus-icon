{
  "name": "@uplus-icon/react",
  "version": "0.2.0-beta.0",
  "description": "React components for Uplus Icon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Upper-Hank/uplus-icon.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Upper-Hank/uplus-icon/issues"
  },
  "homepage": "https://icon.upper.website",
  "keywords": [
    "icon",
    "icons",
    "react",
    "svg",
    "uplus"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dynamic": {
      "types": "./dist/dynamic.d.ts",
      "import": "./dist/dynamic.js"
    },
    "./icons/*": {
      "types": "./dist/generated/icons/*.d.ts",
      "import": "./dist/generated/icons/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uplus-icon/core": "^0.2.0-beta.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

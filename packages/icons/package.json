{
  "name": "@uplus/icons",
  "version": "0.1.0",
  "description": "Official Uplus React icon library",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && tsup src/index.ts --format esm --dts --clean",
    "typecheck": "npm run generate && tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "react": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}

{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@uplus-icon/react": ["../../packages/react/src/index.ts"],
      "@uplus-icon/react/dynamic": ["../../packages/react/src/dynamic.ts"],
      "@uplus-icon/core": ["../../packages/core/src/index.ts"],
      "@uplus-icon/core/internal/weight": ["../../packages/core/src/weight.ts"],
      "@uplus-icon/core/dynamic": ["../../packages/core/src/dynamic.ts"],
      "@uplus-icon/core/metadata": ["../../packages/core/src/metadata.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "references": []
}
